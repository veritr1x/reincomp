 // Snapshot both source registers before writing any aliased destination. The
 // unsigned predicate produces a lane mask, with inactive upper bits cleared.
+// Shift right and insert into the low bits of each destination lane.
+// A shift equal to the lane width leaves that lane's destination intact.
+#define INTEGER_SHIFT_INSERT(bits) \
+  template <size_t lanes> \
+  DEF_SEM(IntegerSRI##bits, V128W dst, V128 previous, V128 src, I64 imm) { \
+    const auto a = UReadV##bits(previous); \
+    const auto b = UReadV##bits(src); \
+    const auto shift = Read(imm); \
+    constexpr uint64_t mask = UINT64_MAX >> (64 - bits); \
+    auto result = UClearV##bits(UReadV##bits(dst)); \
+    _Pragma("unroll") for (size_t i = 0; i < lanes; ++i) { \
+      const uint64_t original = UExtractV##bits(a, i); \
+      const uint64_t source = UExtractV##bits(b, i); \
+      const uint64_t value = shift == bits ? original : \
+          (original & ~(mask >> shift)) | (source >> shift); \
+      result = UInsertV##bits(result, i, static_cast<uint##bits##_t>(value)); \
+    } \
+    UWriteV##bits(dst, result); \
+    return memory; \
+  }
+INTEGER_SHIFT_INSERT(8)
+INTEGER_SHIFT_INSERT(16)
+INTEGER_SHIFT_INSERT(32)
+INTEGER_SHIFT_INSERT(64)
+#undef INTEGER_SHIFT_INSERT
