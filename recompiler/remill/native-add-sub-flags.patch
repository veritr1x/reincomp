+// A plain ADDS/SUBS (including CMP and conditional compares) has no
+// incoming carry. Compute its flags at the guest operand width, so a
+// 64-bit guest comparison lowers to a 64-bit host comparison.
+template <bool subtract, typename T>
+ALWAYS_INLINE T AddSubNZCV(State &state, T lhs, T rhs) {
+  const T result = subtract ? USub(lhs, rhs) : UAdd(lhs, rhs);
+  FLAG_N = SignFlag(result, lhs, rhs);
+  FLAG_Z = ZeroFlag(result, lhs, rhs);
+  FLAG_C = subtract ? lhs >= rhs : result < lhs;
+  bool overflow;
+  if constexpr (subtract) {
+    // N xor V is the signed less-than condition after subtraction.
+    overflow = (Signed(result) < 0) != (Signed(lhs) < Signed(rhs));
+  } else {
+    decltype(Signed(lhs)) signed_result;
+    overflow = __builtin_add_overflow(Signed(lhs), Signed(rhs), &signed_result);
+  }
+  FLAG_V = __remill_flag_computation_overflow(overflow, lhs, rhs, result);
+  return result;
+}
