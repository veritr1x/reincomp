+// Around the Newton iteration's fixed point the binary32 product has at most
+// 48 significant bits. With the exponent sum within four of zero, subtracting
+// it from 2 or 3 needs at most 52 bits and halving remains exact in binary64.
+// Every nonzero result is normal in binary32. Round just once and record IXC.
+template <bool square_root_step>
+ALWAYS_INLINE uint32_t RecipNormalStep32(State &state, uint32_t lhs, uint32_t rhs) {
+  const double a = RecipFPBitCast<float32_t>(lhs);
+  const double b = RecipFPBitCast<float32_t>(rhs);
+  const double exact = square_root_step ? (3.0 - a * b) * 0.5 : 2.0 - a * b;
+  return RoundNormalToBinary32(state, exact);
+}
