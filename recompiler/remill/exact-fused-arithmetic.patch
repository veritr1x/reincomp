+// Narrow an exact finite binary64 value whose nonzero magnitude is normal
+// in binary32. A zero here comes from exact cancellation of nonzero terms.
+ALWAYS_INLINE static uint32_t RoundNormalToBinary32(State &state, double exact) {
+  const uint64_t bits = __builtin_bit_cast(uint64_t, exact);
+  const uint64_t magnitude = bits & UINT64_C(0x7fffffffffffffff);
+  const unsigned mode = state.fpcr.rmode;
+  if (!magnitude) return mode == kFPURoundDownNegInf ? UINT32_C(0x80000000) : 0;
+
+  constexpr uint64_t half = UINT64_C(1) << 28;
+  const uint64_t remainder = magnitude & (2 * half - 1);
+  const uint32_t sign = static_cast<uint32_t>(bits >> 63) << 31;
+  uint32_t rounded = static_cast<uint32_t>((magnitude >> 29) - (uint64_t(1023 - 127) << 23));
+  if (remainder) {
+    state.sr.ixc = 1;
+    if (mode == kFPURoundToNearestEven) {
+      rounded += remainder > half || (remainder == half && (rounded & 1));
+    } else {
+      rounded += (mode == kFPURoundUpInf && !sign) || (mode == kFPURoundDownNegInf && sign);
+    }
+  }
+  return sign | rounded;
+}
