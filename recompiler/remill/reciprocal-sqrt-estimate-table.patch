 // The architecture's eight-fraction-bit estimates are midpoint table lookups,
 // not correctly rounded division/sqrt. Evaluate the table using integer math
 // so host FP rounding, denormal modes, and exception flags cannot affect it.
+// FRSQRTE uses the exponent parity and the top seven fraction bits.
+// Compute the 256 architected buckets once at compile time. Each entry
+// stores the low eight bits of the 9-bit significand.
+struct ReciprocalSqrtTable {
+  uint8_t fraction[256]{};
+  constexpr ReciprocalSqrtTable() {
+    for (unsigned i = 0; i < 256; ++i) {
+      const uint64_t d = 2 * (128 + (i & 127)) + 1;
+      const uint64_t n = UINT64_C(1) << ((i & 128) ? 26 : 25);
+      unsigned low = 256, high = 512;
+      while (low + 1 < high) {
+        const unsigned mid = (low + high) / 2;
+        const uint64_t boundary = 2 * mid - 1;
+        if (d * boundary * boundary <= 4 * n) low = mid;
+        else high = mid;
+      }
+      fraction[i] = static_cast<uint8_t>(low - 256);
+    }
+  }
+};
+constexpr ReciprocalSqrtTable reciprocal_sqrt_table{};
