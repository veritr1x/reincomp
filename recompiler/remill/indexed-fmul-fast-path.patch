+// Indexed FMUL fast path. With FZ and DN clear, round-to-nearest-even, and two
+// finite operands, the fused a*b+(sign-matched zero) below has exactly the
+// correctly rounded IEEE product, which is what ordinary vector FMUL computes
+// through CheckedFloatBinOp (same FPSR flag collection). NaN, infinity and
+// non-default FPCR modes keep the exact fused path.
+// Exact fused path for NaN, infinity and non-default FPCR modes.
+template <typename T>
+ALWAYS_INLINE T IndexedFMulExact(State &state, T lhs, T rhs) {
+  constexpr T sign = T(1) << (sizeof(T) * 8 - 1);
+  return IndexedFusedFPBits<T>(state, T((lhs ^ rhs) & sign), lhs, rhs);
+}
+
+template <typename T, typename F, typename Op>
+ALWAYS_INLINE T IndexedFMulBits(State &state, T lhs, T rhs, Op op) {
+  constexpr unsigned fraction_bits = sizeof(T) == 4 ? 23 : 52;
+  constexpr T sign = T(1) << (sizeof(T) * 8 - 1);
+  constexpr T exponent = T(~(sign | ((T(1) << fraction_bits) - 1)));
+  if (!state.fpcr.fz && !state.fpcr.dn &&
+      state.fpcr.rmode == kFPURoundToNearestEven &&
+      (lhs & exponent) != exponent && (rhs & exponent) != exponent) {
+    const F product = CheckedFloatBinOp(state, op, __builtin_bit_cast(F, lhs),
+                                        __builtin_bit_cast(F, rhs));
+    return __builtin_bit_cast(T, product);
+  }
+  return IndexedFMulExact<T>(state, lhs, rhs);
+}
+
